# API Base URL:
# For production Docker/Nginx and Vite dev proxy, leave as /api/v1 (same-origin)
VITE_API_BASE_URL=/api/v1

# For standalone development with direct backend connection:
# VITE_API_BASE_URL=http://localhost:8000/api/v1

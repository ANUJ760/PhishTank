# ==============================================================================
# GeCompose Frontend Environment Configuration
# ==============================================================================

# Backend API Root URL (used for /api/chat, /api/v1/*, and /health):
# If hosting frontend separately on S3/CloudFront, point this to your AWS App Runner or EC2 backend URL:
# Example: VITE_API_URL=https://api.gecompose.example.com
# For local development with Vite dev proxy (runs on localhost:5173 -> localhost:8000), leave blank:
VITE_API_URL=http://localhost:8000


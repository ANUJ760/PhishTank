# ==============================================================================
# GeCompose Enterprise Environment Configuration
# Production-ready configuration for Local Development & AWS Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Ollama Configuration
# ------------------------------------------------------------------------------
# Provider options: ollama (default), openai, llama-server
LLM_PROVIDER=ollama

# Ollama daemon base URL (default: http://127.0.0.1:11434 for local, or http://ollama:11434 in Docker)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Intake Model (Gemma 4B tier): Multimodal OCR, audio transcription, dispatch extraction
INTAKE_MODEL=gemma3:4b

# Reasoning Model (Gemma 12B tier): Clinical OR triage rationale, logistics synthesis, conflict analysis
REASON_MODEL=gemma3:12b

# Optional direct endpoint overrides (auto-computed from OLLAMA_BASE_URL if unset)
# INTAKE_URL=http://127.0.0.1:11434/v1
# REASON_URL=http://127.0.0.1:11434/v1

# Maximum timeout in seconds for LLM inference requests
LLM_TIMEOUT_S=120

# Mock Mode: Set to 1 to run offline with deterministic fixture data
MOCK_LLM=0

# Fallback Mode: If live inference fails or is offline, fall back to typed fixtures
LLM_FALLBACK_TO_MOCK=1

# ------------------------------------------------------------------------------
# 2. Database & State Registry
# ------------------------------------------------------------------------------
# Option A (Local Zero-Config): SQLite file database
DATABASE_URL=sqlite:///data/gecompose.db

# Option B (Production / AWS RDS): Managed PostgreSQL instance
# DATABASE_URL=postgresql://gecompose:gecompose_dev@postgres:5432/gecompose
# POSTGRES_DB=gecompose
# POSTGRES_USER=gecompose
# POSTGRES_PASSWORD=gecompose_dev
# POSTGRES_PORT=5432

# Automatically fall back to local SQLite if PostgreSQL is unreachable
DB_FALLBACK_SQLITE=1

# Storage directory for ingested uploads (audio, photos, spreadsheets, dispatch reports)
UPLOAD_DIR=data/uploads

# ------------------------------------------------------------------------------
# 3. Server, Network & CORS Configuration
# ------------------------------------------------------------------------------
PORT=8000
FRONTEND_PORT=80
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1

# ------------------------------------------------------------------------------
# 4. Code Execution Sandbox
# ------------------------------------------------------------------------------
# Sandbox execution mode: local (direct subprocess) or docker (isolated container)
SANDBOX_MODE=local

# Docker image name when SANDBOX_MODE=docker
SANDBOX_IMAGE=gecompose-sandbox

# Allow local subprocess sandbox execution for spreadsheet parsers
ALLOW_LOCAL_SANDBOX=1

# ------------------------------------------------------------------------------
# 5. Multimodal Intake Settings
# ------------------------------------------------------------------------------
# Audio mode: native (audio model ingest) or transcript (typed text only)
AUDIO_MODE=native

# ------------------------------------------------------------------------------
# 6. Global Constraint Solver Configuration
# ------------------------------------------------------------------------------
# Working week days (1-5: Mon to Fri)
DAYS=5

# Time slots per day (6 slots: 09:00, 10:00, 11:00, 12:00, 14:00, 15:00)
SLOTS_PER_DAY=6

# Solver time limit in seconds per solve invocation
SOLVER_TIME_S=10

# Deterministic random seed for solver search
SOLVER_SEED=7

# Reference Monday date for exported iCalendar (.ics) files
WEEK_START_MONDAY=2026-10-12

# ------------------------------------------------------------------------------
# 7. AWS Cloud Deployment (ECS / EC2 / EKS)
# ------------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_EXECUTION_ENV=AWS_ECS_FARGATE
# S3_BUCKET_ATTACHMENTS=gecompose-production-attachments
